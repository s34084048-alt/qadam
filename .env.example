# Copy to .env and adjust. docker-compose reads this file automatically.
# ---------------------------------------------------------------------------
# QADAM is NOT A MEDICAL DEVICE and is not for clinical use. Nothing in this
# configuration changes that; there is no switch that makes it clinical.
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
POSTGRES_USER=qadam
POSTGRES_PASSWORD=qadam-secret
POSTGRES_DB=qadam
POSTGRES_PORT=5432
# Used by the API container. For a bare `uvicorn` run without Postgres, the
# default in app/config.py is SQLite and needs no value here.
# DATABASE_URL=postgresql+asyncpg://qadam:qadam-secret@db:5432/qadam

# --- object storage --------------------------------------------------------
# s3 targets MinIO locally and any S3-compatible, data-resident bucket in
# production. `local` writes to LOCAL_STORAGE_DIR (dev and tests only).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=qadam-images
S3_ACCESS_KEY=qadam
S3_SECRET_KEY=qadam-secret
S3_REGION=me-central-1
S3_USE_SSL=false
LOCAL_STORAGE_DIR=./_storage

# --- auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# --- app -------------------------------------------------------------------
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
WEB_PORT=8080
MAX_UPLOAD_BYTES=20971520

# --- analysis --------------------------------------------------------------
# inline runs the pipeline in a worker thread inside the API process.
# queue is the Celery/RQ slot (see app/analysis/runner.py) -- not wired up.
ANALYSIS_RUNNER=inline
REDIS_URL=redis://redis:6379/0

# --- quality gate ----------------------------------------------------------
QUALITY_MIN_SHORT_SIDE=240
QUALITY_MIN_FOCUS_VAR=60
QUALITY_EXPOSURE_MIN=45
QUALITY_EXPOSURE_MAX=215
QUALITY_MIN_SUBJECT_FRACTION=0.08

# --- compliance ------------------------------------------------------------
DATA_RESIDENCY=UAE
REQUIRE_CONSENT=true

# --- seeding ---------------------------------------------------------------
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@qadam.local
SEED_ADMIN_PASSWORD=qadam-admin
SEED_CLINICIAN_EMAIL=clinician@qadam.local
SEED_CLINICIAN_PASSWORD=qadam-clinician
