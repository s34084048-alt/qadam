# Never commit patient images, databases or secrets.
_storage/
*.db
*.sqlite3
.env

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

node_modules/
dist/
.vite/

# Written by `python -m app.seed`, regenerated from sample_data.py. A pattern
# containing a slash is anchored to this directory, so the old `samples/*.png`
# never matched api/samples/ and committed 14 MB of regenerable images.
**/samples/*.png

*.onnx
*.pt

# Development TLS material. A private key must never reach a repository.
certs/
*.pem
*.key
